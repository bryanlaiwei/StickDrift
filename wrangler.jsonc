// Cloudflare Worker for the Stick Drift website.
// `wrangler deploy` builds the Vite app in web/ first, then uploads web/dist as static files.
// Requests to /api/* run deploy/worker.js, which forwards them to the FastAPI backend at BACKEND_URL.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stickdrift",
  "main": "deploy/worker.js",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "cd web && npm ci && npm run build"
  },
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    // React Router paths such as /caregiver/residents/:id fall back to index.html
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
  // BACKEND_URL (for example https://stickdrift-api.example.com) is set in the Cloudflare dashboard:
  // Worker -> Settings -> Variables and Secrets.
}
