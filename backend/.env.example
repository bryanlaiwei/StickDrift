# Copy to backend/.env and replace with your TigerData service connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
# Access code caregivers must enter to register. Leave empty to turn caregiver registration off.
CAREGIVER_INVITE_CODE=
# Python of the root uv environment (`uv sync` in the repository root). It scores lobby visits and draws
# their hand replays. Defaults to ../.venv/bin/python; on Windows use the full path of .venv\Scripts\python.exe.
# STICKDRIFT_GAME_PYTHON=
